{
  "name": "@neondatabase/mcp-server-neon",
  "version": "2.0.0",
  "description": "MCP server for interacting with Neon Management API and databases",
  "license": "MIT",
  "author": "Neon, Inc. (https://neon.com/)",
  "homepage": "https://github.com/neondatabase/mcp-server-neon/",
  "bugs": "https://github.com/neondatabase/mcp-server-neon/issues",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsx scripts/lint-ratchet.ts",
    "lint:shrink": "tsx scripts/lint-ratchet.ts --shrink",
    "lint:report": "tsx scripts/lint-ratchet.ts --report",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types effect-tsgo oxlint --type-aware --fix && prettier -w .",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier -w .",
    "fmt:check": "prettier --check .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.e2e.test.ts\"",
    "test:integration": "vitest run mcp/__tests__/*.integration.test.ts --testTimeout=30000 --hookTimeout=30000",
    "test:e2e:mcp": "vitest run mcp/__tests__/*.e2e.test.ts",
    "test:e2e:live": "vitest run mcp/__tests__/live/*.e2e.test.ts",
    "test:e2e:web": "tsx scripts/e2e-setup.ts && playwright test",
    "test:ci": "pnpm test:unit && pnpm test:integration && pnpm test:e2e:mcp",
    "test:e2e": "pnpm test:e2e:mcp && pnpm test:e2e:web"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.1.2",
    "@modelcontextprotocol/sdk": "1.25.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@neon/sdk": "7.13.0",
    "@neon/tools": "2.14.2",
    "@neondatabase/serverless": "1.0.0",
    "@opentelemetry/api": "1.9.1",
    "@segment/analytics-node": "2.2.1",
    "@sentry/node": "10.78.0",
    "@vercel/functions": "3.3.4",
    "effect": "4.1.2",
    "he": "1.2.0",
    "jose": "6.2.2",
    "keyv": "5.3.2",
    "mcp-handler": "2.1.0",
    "next": "16.1.1",
    "oauth2-server": "3.1.1",
    "openid-client": "6.3.4",
    "pg": "8.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "redis": "4.6.0",
    "winston": "3.17.0",
    "winston-transport": "4.9.0",
    "zod": "4.6.5",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@oxlint/plugins": "1.91.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.7",
    "@types/he": "1.2.3",
    "@types/node": "20.17.48",
    "@types/oauth2-server": "3.0.18",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.1.5",
    "dotenv": "17.2.4",
    "knip": "5.83.1",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.8.1",
    "tailwindcss": "4.1.7",
    "tsx": "4.21.0",
    "typescript": "5.8.3",
    "vitest": "4.0.18"
  }
}
